generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum ImageCategory {
  HERO
  GALLERY_HAIR
  GALLERY_BRIDAL
  GALLERY_NAIL
  GALLERY_SKIN
  GALLERY_MAKEUP
  INTERIOR
  OFFER
  SERVICE_ICON
  OTHER
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(MANAGER)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImageAsset {
  id        String        @id @default(cuid())
  name      String
  url       String
  category  ImageCategory @default(OTHER)
  alt       String?
  detail    String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ServiceCategory {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  icon          String
  desc          String
  gradient      String        @default("from-rose-500/20 to-pink-500/20")
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories SubCategory[]
}

model SubCategory {
  id         String          @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      ServiceItem[]
}

model ServiceItem {
  id            String      @id @default(cuid())
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  duration      Int         @default(30)
  membershipPrice Float?
  rewardPoints  Int         @default(0)
  serviceFor    String      @default("Female")
  hideOnWebsite Boolean     @default(false)
  desc          String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ServicePackage {
  id            String   @id @default(cuid())
  name          String
  originalPrice String
  price         String
  durationDays  Int      @default(90)
  validUpto     String?
  items         Json
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Offer {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  badge           String   @default("HOT")
  badgeColor      String   @default("from-rose-500 to-red-500")
  image           String
  serviceSlug     String
  subCategoryName String
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  alt       String
  tagline   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interior {
  id        String   @id @default(cuid())
  image     String
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// CRM CORE ENTITIES (Database models)
// ----------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String
  email     String?
  gst       String?
  hours     String   @default("10:00-20:00")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            String        @id @default(cuid())
  name          String
  phone         String        @unique
  email         String?
  gender        String        @default("Female")
  dob           String?
  anniversary   String?
  address       String?       @default("Jaunpur")
  source        String        @default("Walk-in")
  inviteCode    String        @unique
  points        Int           @default(0)
  walletBalance Float         @default(0)
  membershipId  String?
  firstVisit    DateTime      @default(now())
  lastVisit     DateTime      @default(now())
  bills         Bill[]
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ServiceProvider {
  id                String   @id @default(cuid())
  name              String
  phone             String
  email             String?
  category          String   @default("Service Provider") // "Service Provider" | "Administrative"
  department        String?  @default("Salon & Spa")
  emergency         String?
  emergencyPhone    String?
  type              String   @default("Beautician") // Role / Designation
  specialization    String?  @default("Hair & Beauty")
  experienceYears   Int      @default(1)
  commissionService Float    @default(15)
  commissionProduct Float    @default(10)
  salary            Float    @default(12000)
  hoursStart        String   @default("10:00")
  hoursEnd          String   @default("19:00")
  gender            String   @default("Female")
  dob               String?
  joiningDate       String?
  bloodGroup        String?
  address           String?
  panNumber         String?
  panDoc            String?
  aadharNumber      String?
  aadharDoc         String?
  photo             String?
  bankName          String?
  bankAccount       String?
  ifscCode          String?
  upiId             String?
  attendanceId      String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Appointment {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName String
  phone      String
  date       String
  time       String
  services   Json
  total      Float    @default(0)
  advance    Float    @default(0)
  status     String   @default("Pending")
  source     String   @default("Software")
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bill {
  id            String        @id @default(cuid())
  billNo        String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName    String
  phone         String
  date          String
  items         Json
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  taxRate       Float         @default(0)
  taxAmount     Float         @default(0)
  advanceAdjust Float         @default(0)
  walletDeduct  Float         @default(0)
  total         Float         @default(0)
  paid          Float         @default(0)
  pending       Float         @default(0)
  payments      Json
  status        String        @default("Settled")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Enquiry {
  id             String   @id @default(cuid())
  clientName     String
  phone          String
  email          String?
  address        String?
  enquiryFor     String
  enquiryType    String   @default("General Inquiry")
  response       String?
  followDate     String
  source         String   @default("Walk-in")
  representative String?
  status         String   @default("Warm")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Feedback {
  id            String   @id @default(cuid())
  billNo        String
  clientName    String
  email         String?
  overall       Int      @default(5)
  timely        Int      @default(5)
  support       Int      @default(5)
  satisfaction  Int      @default(5)
  serviceRating Int      @default(5)
  review        String?
  suggestion    String?
  date          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id           String         @id @default(cuid())
  name         String
  mrp          Float
  salePrice    Float
  volume       String         @default("100")
  unit         String         @default("ML")
  barcode      String         @unique
  rewardPoints Int            @default(0)
  stock        Int            @default(0)
  usages       ProductUsage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductUsage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName  String
  qty          Int      @default(1)
  providerId   String
  providerName String
  assignedBy   String   @default("Super Admin")
  date         String
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  gst       String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockPurchase {
  id         String   @id @default(cuid())
  vendorId   String
  vendorName String
  invoiceNo  String?
  date       String
  items      Json
  total      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  date        String
  type        String
  amount      Float
  paymentMode String   @default("Cash")
  recipient   String
  paidBy      String   @default("Super Admin")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Membership {
  id                   String   @id @default(cuid())
  name                 String
  price                Float
  durationDays         Int      @default(365)
  rewardOnPurchase     Int      @default(0)
  discountServices     Float    @default(10)
  discountServicesType String   @default("%")
  discountProducts     Float    @default(10)
  discountProductsType String   @default("%")
  discountPackages     Float    @default(10)
  discountPackagesType String   @default("%")
  pointsBoost          String   @default("1X")
  minPoints            Int      @default(0)
  minBill              Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  discount     Float
  discountType String   @default("%")
  minBill      Float    @default(0)
  maxDiscount  Float    @default(0)
  perUser      Int      @default(1)
  validTill    String
  rewardPoints Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceReminder {
  id          String   @id @default(cuid())
  serviceId   String
  serviceName String
  afterDays   Int      @default(30)
  template    String
  channel     String   @default("WhatsApp")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SelfAssessment {
  id           String   @id @default(cuid())
  date         String
  branchId     String   @default("b1")
  branchName   String   @default("Jaunpur")
  cleanliness  Int      @default(5)
  reception    Int      @default(5)
  service      Int      @default(5)
  punctuality  Int      @default(5)
  display      Int      @default(5)
  feedback     Int      @default(5)
  targetMet    Boolean  @default(true)
  targetAmount Float    @default(0)
  actualAmount Float    @default(0)
  notes        String?
  submittedBy  String   @default("Super Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SmsLog {
  id         String   @id @default(cuid())
  date       String
  clientName String
  phone      String
  type       String
  channel    String   @default("WhatsApp")
  message    String
  status     String   @default("Sent")
  sentBy     String   @default("Super Admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InterBranchTransfer {
  id         String   @id @default(cuid())
  date       String
  type       String   @default("Stock")
  fromBranch String
  toBranch   String
  details    Json
  status     String   @default("Completed")
  by         String   @default("Super Admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attendance {
  id           String   @id @default(cuid())
  staffId      String
  staffName    String
  type         String   @default("Service Provider")
  date         String
  inTime       String?
  outTime      String?
  status       String   @default("Present")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
