// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model HeroSlide {
    id        String             @id(map: "HeroSlide_pkey")
    image     String
    alt       String
    tagline   String
    order     Int                @default(0)
    isActive  Boolean            @default(true)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)

    @@map("HeroSlide")
  }

  model ImageAsset {
    id        String                 @id(map: "ImageAsset_pkey")
    name      String
    url       String
    category  pg.enum(ImageCategory) @default("OTHER")
    alt       String?
    detail    String?
    order     Int                    @default(0)
    createdAt TimestampString(3)     @default(now())
    updatedAt TimestampString(3)

    @@map("ImageAsset")
  }

  model Interior {
    id        String             @id(map: "Interior_pkey")
    image     String
    title     String
    desc      String
    order     Int                @default(0)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)

    @@map("Interior")
  }

  model Offer {
    id              String             @id(map: "Offer_pkey")
    title           String
    subtitle        String
    badge           String             @default("HOT")
    badgeColor      String             @default("from-rose-500 to-red-500")
    image           String
    serviceSlug     String
    subCategoryName String
    isActive        Boolean            @default(true)
    order           Int                @default(0)
    createdAt       TimestampString(3) @default(now())
    updatedAt       TimestampString(3)

    @@map("Offer")
  }

  model PrismaMigrations {
    id                VarChar(36)        @id(map: "_prisma_migrations_pkey")
    checksum          VarChar(64)
    finishedAt        TimestamptzString? @map("finished_at")
    migrationName     VarChar(255)       @map("migration_name")
    logs              String?
    rolledBackAt      TimestamptzString? @map("rolled_back_at")
    startedAt         TimestamptzString  @default(now()) @map("started_at")
    appliedStepsCount Int                @default(0) @map("applied_steps_count")

    @@map("_prisma_migrations")
  }

  model ServiceCategory {
    id            String             @id(map: "ServiceCategory_pkey")
    slug          String
    name          String
    icon          String
    desc          String
    gradient      String             @default("from-rose-500/20 to-pink-500/20")
    order         Int                @default(0)
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    subCategories SubCategory[]

    @@index([slug], map: "ServiceCategory_slug_key", unique: true)
    @@map("ServiceCategory")
  }

  model SubCategory {
    id           String             @id(map: "SubCategory_pkey")
    categoryId   String
    name         String
    order        Int                @default(0)
    createdAt    TimestampString(3) @default(now())
    updatedAt    TimestampString(3)
    serviceItems ServiceItem[]
    category     ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SubCategory_categoryId_fkey", index: false)

    @@map("SubCategory")
  }

  model ServiceItem {
    id            String             @id(map: "ServiceItem_pkey")
    subCategoryId String
    name          String
    price         Float
    desc          String?
    order         Int                @default(0)
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    subCategory   SubCategory        @relation(fields: [subCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceItem_subCategoryId_fkey", index: false)

    @@map("ServiceItem")
  }

  model ServicePackage {
    id            String             @id(map: "ServicePackage_pkey")
    name          String
    originalPrice String
    price         String
    items         Jsonb
    order         Int                @default(0)
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)

    @@map("ServicePackage")
  }

  model User {
    id        String             @id(map: "User_pkey")
    name      String
    email     String
    password  String
    role      pg.enum(Role)      @default("MANAGER")
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)

    @@index([email], map: "User_email_key", unique: true)
    @@map("User")
  }

  native_enum ImageCategory {
    HERO = "HERO"
    GALLERY_HAIR = "GALLERY_HAIR"
    GALLERY_BRIDAL = "GALLERY_BRIDAL"
    GALLERY_NAIL = "GALLERY_NAIL"
    GALLERY_SKIN = "GALLERY_SKIN"
    GALLERY_MAKEUP = "GALLERY_MAKEUP"
    INTERIOR = "INTERIOR"
    OFFER = "OFFER"
    SERVICE_ICON = "SERVICE_ICON"
    OTHER = "OTHER"
  }

  native_enum Role {
    ADMIN = "ADMIN"
    MANAGER = "MANAGER"
  }
}
